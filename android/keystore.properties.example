# Mall för signeringen av release-bygget.
#
# Kör så här en gång på din egen dator (nyckeln hamnar utanför repot):
#
#   keytool -genkeypair -v -keystore "$USERPROFILE/.parkeraisthlm/upload-key.jks" \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Kopiera sedan den här filen till android/keystore.properties och fyll i uppgifterna.
# android/keystore.properties och alla *.jks-filer är ignorerade av git – lägg aldrig
# nyckeln eller lösenorden i versionshanteringen. Ta en säkerhetskopia: tappar du
# uppladdningsnyckeln får du begära en återställning i Play Console (appen och dess
# signeringsnyckel påverkas inte).
#
# storeFile: sökväg till nyckelfilen, absoluta sökvägar fungerar bäst på Windows.
storeFile=C:/Users/DITTNAMN/.parkeraisthlm/upload-key.jks
storePassword=LÖSENORD
keyAlias=upload
keyPassword=LÖSENORD
